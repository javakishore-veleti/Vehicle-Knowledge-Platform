# Copy to .env and uncomment ONE profile per section. scripts/run.sh loads this on start.
# ${VAR} references resolve from your shell env (e.g. GROQ_API_KEY / OPENAI_API_KEY from ~/.zshrc).

# ============================================================================
# LLM answer providers — the query is answered by EVERY enabled provider (compared in the UI).
# Comma list of ids from providers.py REGISTRY: openai, groq-70b, groq-8b, google, anthropic.
# Each is used only if its key env (OPENAI_API_KEY / GROQ_API_KEY / GOOGLE_API_KEY /
# ANTHROPIC_API_KEY) is set in your shell. Default below.
# ----------------------------------------------------------------------------
VKP_LLM_PROVIDERS=openai,groq-70b,groq-8b
# Add more once you have valid keys, e.g.:  openai,groq-70b,groq-8b,google,anthropic

# ============================================================================
# Retrieval store. Default = pgvector.
# ----------------------------------------------------------------------------
# VKP_VECTOR_STORE=pgvector        # or: mongodb

# ============================================================================
# Query embedding provider — MUST match the model that filled the table/collection.
# Default = sentence-transformers (local fastembed, 384d).
# ----------------------------------------------------------------------------
# sentence-transformers (local, no key):
# VKP_EMBED_PROVIDER=sentence-transformers
# VKP_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# VKP_VECTOR_TABLE=vec_all_minilm_l6_v2
#
# OpenAI embeddings (1536d; needs OpenAI credit + content indexed with the openai-small formula):
# VKP_EMBED_PROVIDER=openai
# VKP_EMBED_MODEL=text-embedding-3-small
# VKP_VECTOR_TABLE=vec_text_embedding_3_small
