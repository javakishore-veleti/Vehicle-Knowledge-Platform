<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.jk.labs.vkp</groupId>
  <artifactId>customer-service</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <name>customer-service</name>
  <description>VKP Customer Management Service (Admin) - Customer and Customer Resource CRUD</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- springdoc (Swagger UI) is not managed by the Spring Boot BOM; pin it here. -->
    <springdoc.version>2.6.0</springdoc.version>
  </properties>

  <modules>
    <module>common</module>
    <module>utils</module>
    <module>dao</module>
    <module>service</module>
    <module>api</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <!-- Internal module versions, managed centrally -->
      <dependency>
        <groupId>com.jk.labs.vkp</groupId>
        <artifactId>customer-common</artifactId>
        <version>0.1.0</version>
      </dependency>
      <dependency>
        <groupId>com.jk.labs.vkp</groupId>
        <artifactId>customer-utils</artifactId>
        <version>0.1.0</version>
      </dependency>
      <dependency>
        <groupId>com.jk.labs.vkp</groupId>
        <artifactId>customer-dao</artifactId>
        <version>0.1.0</version>
      </dependency>
      <dependency>
        <groupId>com.jk.labs.vkp</groupId>
        <artifactId>customer-service-core</artifactId>
        <version>0.1.0</version>
      </dependency>
      <!-- Swagger UI / OpenAPI -->
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

</project>
