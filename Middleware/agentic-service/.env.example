# Copy to .env. The agent SDKs talk to OpenAI if OPENAI_API_KEY is set, else free Groq.
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk-...
# GOOGLE_API_KEY=...        # for the google-adk framework (Gemini), once added

# Retrieval (the indexed pgvector tables — same as the explore service)
# VKP_PG_HOST=localhost
# VKP_VECTOR_TABLE=vec_all_minilm_l6_v2
# VKP_EMBED_PROVIDER=sentence-transformers
