# Copy to .env. Reasoning uses OpenAI if OPENAI_API_KEY set, else free Groq.
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk-...
# CEF_AGENTIC_URL=http://localhost:8092   # route reasoning to the VKP agent roster (any framework)
# CEF_DEFAULT_FRAMEWORK=openai-agents
# VKP_PG_HOST=localhost
# VKP_VECTOR_TABLE=vec_all_minilm_l6_v2
# CEF_MEMORY_ENABLED=true                 # MongoDB-backed memory; false / no Mongo -> in-process
